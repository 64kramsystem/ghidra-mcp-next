# GhidraMCP-next supports Ghidra 12.2 and JDK 25 only.
# Copy to .env for setup/deployment. GHIDRA_INSTALL_DIR in the environment
# takes precedence over GHIDRA_PATH.
GHIDRA_PATH=

# Python used by the debugger launchers. Setup installs the bundled 12.2
# ghidratrace wheel and its protobuf dependency into this interpreter.
GHIDRA_DEBUGGER_PYTHON=

# Optional loopback TCP endpoint used by deployment and companion MCP clients.
# Enable TCP Transport in GhidraMCP-next before using it.
# The stdio bridge discovers Unix-domain sockets independently.
GHIDRA_MCP_URL=http://127.0.0.1:8089
